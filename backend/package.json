{
  "name": "@climence/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"!src/**/*.integration.test.ts\"",
    "test:integration": "node --import tsx --test \"src/**/*.integration.test.ts\"",
    "test:integration:legacy": "tsx test.js"
  },
  "dependencies": {
    "@climence/shared": "*",
    "@types/ws": "^8.18.1",
    "aedes": "^1.0.2",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}